[Unit]
Description=Rclone Bisync with Google Drive
Documentation=man:rclone(1)
# Ensure the daemon is running before we start
Requires=rclone-daemon.service
After=rclone-daemon.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Load DBus environment variables for desktop notifications
EnvironmentFile=-%h/.config/dbus-vars
EnvironmentFile=-%h/rclone-bisync/rc-secrets.env

# Set the working directory to the script's location
WorkingDirectory=%h/rclone-bisync

# Command to execute the Python script
# -u flag ensures unbuffered output for immediate logging
ExecStart=/usr/bin/python3 -u %h/rclone-bisync/bisync_gdrive_advanced.py

# Only restart on actual failures, not on successful completion
# This service is designed to be triggered by timer, not run continuously
Restart=no

# If the script fails, log detailed information
# StandardOutput and StandardError go to systemd journal
StandardOutput=journal
StandardError=journal

# Add context to journal entries
SyslogIdentifier=bisync-gdrive

# Timeout settings
# Kill the script if it runs longer than 30 minutes (something is wrong)
TimeoutStartSec=30min

# Security hardening (optional but recommended)
# These prevent the script from doing things it shouldn't need to do
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (prevents runaway process)
# Adjust based on your sync size
MemoryMax=1G
CPUQuota=80%

[Install]
WantedBy=default.target

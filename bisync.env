# ==============================================================================
# Rclone Bisync Operational Configuration (bisync.env)
# Tracked in Git, safely editable without exposing sensitive credentials.
# ==============================================================================

# --- Default Bootstrap & CLI Fallback Paths ---
# NOTE: In multi-profile Bisync Hub, each profile in profiles.json defines its
# own independent local and remote paths. The paths below serve as fallback defaults for:
#   1. Bootstrapping the primary default profile upon fresh installation
#   2. Ad-hoc CLI operations executed without a profile argument (e.g. `rclone-bisync sync`)
LOCAL_PATH=~/gdrive
REMOTE_PATH=gdrive:

# --- Global Fleet Defaults (Baseline for New Profiles) ---
# Baseline operational policies applied when creating new sync profiles
GLOBAL_MAX_DELETE=50
GLOBAL_CANARY_VALIDATION=true
GLOBAL_CONFLICT_RESOLVE=newer
GLOBAL_COMPARE_MODE=size,modtime
GLOBAL_REMOVE_EMPTY_DIRS=true
GLOBAL_CREATE_EMPTY_DIRS=true
GLOBAL_LOCK_EXPLORER_REMOTE=false

# --- Rclone Bisync Fleet Baseline Arguments ---
# Process-global baseline CLI parameters passed to the background daemon engine.
# Profiles with matching engine configurations run concurrently up to maxConcurrency;
# profiles with custom overrides queue safely and dynamically switch rates.
RCLONE_COMMON_ARGS="--use-json-log --color NEVER --check-access --check-first --track-renames --remove-empty-dirs --resilient --recover --retries 4 --retries-sleep 15s --low-level-retries 10 --tpslimit 10 --tpslimit-burst 10 --fast-list --buffer-size 32M --conflict-resolve newer --conflict-loser num"

# --- Persistent Cache Configuration ---
# Dedicated persistent cache directory used for Hasher database, VFS cache, and bisync listings.
# The systemd daemon is configured with `--cache-dir %h/.cache/rclone`.
RCLONE_CACHE_DIR=~/.cache/rclone

# --- Notification Intervals ---
# Desktop notification app name and throttling intervals
NOTIFICATION_APP_NAME="Rclone Bisync"
SUCCESS_NOTIFICATION_INTERVAL_MIN=30
ERROR_NOTIFICATION_REPEAT_HOURS=6

# --- External Alerting & Watchdog Heartbeats ---
# Alert webhook (Discord, Slack) and dead man's snitch heartbeat URL
# Note: Sensitive webhook tokens may also be stored securely in rc-secrets.env
WEBHOOK_URL=""
WEBHOOK_TIMEOUT=5
WATCHDOG_PING_URL=""
WATCHDOG_TIMEOUT=5

# --- Logging & Rotation ---
MAX_LOG_SIZE_MB=5
LOG_BACKUP_COUNT=5

# --- Daemon Health & Startup ---
DAEMON_STARTUP_TIMEOUT_SEC=30
DAEMON_HEALTH_CHECK_RETRIES=2
RETRY_DELAY=1

# --- Job Polling & Timeouts ---
JOB_POLL_INITIAL_SLEEP=2
JOB_POLL_MAX_SLEEP=10
JOB_POLL_BACKOFF_MULTIPLIER=1.5
JOB_TIMEOUT_SECONDS=1800

# --- Rate Limit Backoff ---
RATE_LIMIT_BACKOFF_HOURS=1
RATE_LIMIT_RETRY_AFTER_BACKOFF=true

# --- Concurrency & Process Lock File ---
LOCK_STALE_TIMEOUT_SECONDS=3600
CHECK_STALE_LOCKS=true

# --- Telemetry & Metrics Ledger ---
ENABLE_METRICS=true
METRICS_MAX_ENTRIES=1000
METRICS_MAX_BACKUPS=5

# --- Post-Sync Cleanup ---
# Comma-separated glob patterns to clean up in LOCAL_PATH after successful sync (e.g. *.tmp, *.conflict, *.~lock*)
FILES_TO_CLEANUP=""

# --- Safety & Conflict Backups ---
# Retention time-to-live (in hours) for conflict resolution backups in review_backups/
REVIEW_BACKUP_TTL_HOURS=48.0

# --- Model Context Protocol (MCP) Server ---
# Configures embedded MCP tools for AI coding agents (Claude Desktop, Cline, Cursor)
MCP_ENABLED=true
MCP_READ_ONLY=false
MCP_HOST=127.0.0.1
MCP_PORT=8081

# --- Startup Validation ---
VALIDATE_CONFIG_ON_STARTUP=true
REQUIRE_LOCAL_PATH_EXISTS=true

# --- Debug Mode ---
DEBUG_MODE=false

# --- Subsystem Feature Flags ---
FEATURE_STALE_LOCK_DETECTION=true
FEATURE_RATE_LIMIT_BACKOFF=true
FEATURE_DAEMON_HEALTH_CHECK=true
FEATURE_METRICS_COLLECTION=true
FEATURE_SMART_NOTIFICATIONS=true
FEATURE_WEBHOOK_ALERTS=false


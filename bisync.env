# ==============================================================================
# Rclone Bisync Operational Configuration (bisync.env)
# Tracked in Git, safely editable without exposing sensitive credentials.
# ==============================================================================

# --- Paths & Remote Mapping ---
# Local directory to synchronize (supports ~ for user home expansion)
LOCAL_PATH=~/gdrive

# Target Rclone remote identifier
REMOTE_PATH=gdrive:

# --- Rclone Bisync Arguments ---
# Single-line quoted string of CLI parameters passed to the sync engine.
# Standard shell quoting and escaping are automatically parsed via shlex.
RCLONE_COMMON_ARGS="--use-json-log --color NEVER --check-access --check-first --track-renames --remove-empty-dirs --resilient --recover --retries 4 --retries-sleep 15s --low-level-retries 10 --tpslimit 10 --tpslimit-burst 10 --fast-list --buffer-size 32M --conflict-resolve newer --conflict-loser num"

# --- Notification Intervals ---
# Desktop notification app name and throttling intervals
NOTIFICATION_APP_NAME="Rclone Bisync"
SUCCESS_NOTIFICATION_INTERVAL_MIN=30
ERROR_NOTIFICATION_REPEAT_HOURS=6

# --- Logging & Rotation ---
MAX_LOG_SIZE_MB=5
LOG_BACKUP_COUNT=5

# --- Daemon Health & Startup ---
DAEMON_STARTUP_TIMEOUT_SEC=30
DAEMON_HEALTH_CHECK_RETRIES=2
RETRY_DELAY=1

# --- Job Polling & Timeouts ---
JOB_POLL_INITIAL_SLEEP=2
JOB_POLL_MAX_SLEEP=10
JOB_POLL_BACKOFF_MULTIPLIER=1.5
JOB_TIMEOUT_SECONDS=1800

# --- Rate Limit Backoff ---
RATE_LIMIT_BACKOFF_HOURS=1
RATE_LIMIT_RETRY_AFTER_BACKOFF=true

# --- Concurrency & Process Lock File ---
LOCK_STALE_TIMEOUT_SECONDS=3600
CHECK_STALE_LOCKS=true

# --- Telemetry & Metrics Ledger ---
ENABLE_METRICS=true
METRICS_MAX_ENTRIES=1000
METRICS_MAX_BACKUPS=5

# --- Post-Sync Cleanup ---
# Comma-separated glob patterns to clean up in LOCAL_PATH after successful sync (e.g. *.tmp, *conflict*)
FILES_TO_CLEANUP=""

# --- Startup Validation ---
VALIDATE_CONFIG_ON_STARTUP=true
REQUIRE_LOCAL_PATH_EXISTS=true

# --- Debug Mode ---
DEBUG_MODE=false

# --- Subsystem Feature Flags ---
FEATURE_STALE_LOCK_DETECTION=true
FEATURE_RATE_LIMIT_BACKOFF=true
FEATURE_DAEMON_HEALTH_CHECK=true
FEATURE_METRICS_COLLECTION=true
FEATURE_SMART_NOTIFICATIONS=true
FEATURE_WEBHOOK_ALERTS=false

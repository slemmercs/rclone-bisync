# ==============================================================================
# Rclone Remote Control (RC) Secrets & Private Endpoints (rc-secrets.env)
# Permissions must be restricted: chmod 600 rc-secrets.env
# Keep this file out of git (.gitignore)
# ==============================================================================

RC_USER=your_rclone_username_here
RC_PASS=your_rclone_password_here
RC_PORT=5572

# Optional External Watchdog Heartbeat ("Dead-Man's Snitch")
# e.g., https://hc-ping.com/your-uuid
WATCHDOG_PING_URL=
WATCHDOG_TIMEOUT=5

# Optional Webhook Alert URL (e.g., Slack, Discord, Gotify, Telegram)
WEBHOOK_URL=
WEBHOOK_TIMEOUT=5


[Unit]
Description=Rclone Telemetry Dashboard UI Backend
After=network.target rclone-daemon.service
Requires=rclone-daemon.service

[Service]
Type=simple
WorkingDirectory=%h/rclone-bisync
ExecStart=%h/rclone-bisync/bin/rclone-bisync dashboard --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5s

# Resource constraints
MemoryMax=512M
CPUQuota=50%
NoNewPrivileges=true

[Install]
WantedBy=default.target

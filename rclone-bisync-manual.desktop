[Desktop Entry]
Categories=Utility;
Comment=Force a full bidirectional sync now via systemd
Exec=systemctl --user start bisync-gdrive.service
Icon=sync
Name=Rclone Force Bisync
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=

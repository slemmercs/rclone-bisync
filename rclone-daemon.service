[Unit]
Description=Rclone Remote Control Daemon
Documentation=https://rclone.org/rc/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Load the secrets file
EnvironmentFile=%h/rclone-bisync/rc-secrets.env

# Use systemd variable substitution for user and pass
ExecStart=/usr/bin/rclone rcd \
    --rc-addr localhost:${RC_PORT} \
    --rc-user=${RC_USER} \
    --rc-pass=${RC_PASS} \
    --log-level INFO \
    --log-file %h/rclone-bisync/rclone-daemon.log \
    --log-file-max-size 10M \
    --log-file-max-backups 5 \
    --use-json-log \
    --cache-dir %h/.cache/rclone

ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5; do curl -sf -u ${RC_USER}:${RC_PASS} -X POST http://localhost:${RC_PORT}/core/stats > /dev/null && exit 0; sleep 2; done; exit 1'
ExecStop=-/usr/bin/curl -sf -u ${RC_USER}:${RC_PASS} -X POST http://localhost:${RC_PORT}/core/quit
Restart=always
RestartSec=10s

# Updated memory limits for cgroups v2 to resolve deprecation warnings
MemoryMax=2G
MemoryHigh=1.5G
CPUQuota=150%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rclone-daemon

[Install]
WantedBy=default.target
[Unit]
Description=Rclone Remote Control Daemon
Documentation=https://rclone.org/rc/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/rclone rcd \
    --rc-addr localhost:5572 \
    --rc-no-auth \
    --log-level INFO \
    --log-file %h/rclone-bisync/rclone-daemon.log \
    --use-json-log \
    --cache-dir %h/.cache/rclone

ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5; do curl -sf -X POST http://localhost:5572/core/stats > /dev/null && exit 0; sleep 2; done; exit 1'
ExecStop=/usr/bin/curl -sf -X POST http://localhost:5572/core/quit
Restart=always
RestartSec=10s

# Updated memory limits for cgroups v2 to resolve deprecation warnings
MemoryMax=2G
MemoryHigh=1.5G
CPUQuota=150%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rclone-daemon

[Install]
WantedBy=default.target